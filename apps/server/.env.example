# CollabStream — Server environment variables
# Copy this file to .env and fill in your values

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Never expose to client

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_or_sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...       # $5/mo recurring — create in Stripe dashboard
STRIPE_BUSINESS_PRICE_ID=price_...  # $15/mo recurring — create in Stripe dashboard

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=collabstream-recordings
R2_PUBLIC_URL=https://your-r2-public-url  # Optional: only if bucket has public access

# ── Server config ─────────────────────────────────────────────────────────────
PORT=3001
ADMIN_TOKEN=change-me-in-production
RETENTION_DAYS=30
MAX_RECORDING_UPLOAD_MB=100
MAX_LOGO_UPLOAD_MB=2
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
TRUST_PROXY=false              # Set true only when deployed behind a trusted proxy/load balancer
WEB_URL=http://localhost:5173   # Used for Stripe redirect URLs
PUBLIC_WEB_ORIGIN=              # Optional: set to ngrok/public URL for QR codes
CORS_ORIGINS=http://localhost:5173  # Comma-separated browser origins allowed to call the API
PUBLIC_WEB_PORT=5173

# Dev tunnel
NGROK_AUTHTOKEN=                # Optional: lets `npm run tunnel` start an authenticated ngrok tunnel
