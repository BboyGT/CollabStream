# CollabStream — Web environment variables
# Copy this file to .env.local and fill in your values

# ── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key   # Safe to expose — protected by RLS

# ── Stripe (public price IDs only — no secret keys here) ─────────────────────
VITE_STRIPE_PRO_PRICE_ID=price_...
VITE_STRIPE_BUSINESS_PRICE_ID=price_...

# ── Server / signaling ────────────────────────────────────────────────────────
VITE_SERVER_URL=http://localhost:3001
VITE_SIGNAL_URL=ws://localhost:3001/ws

# ── Public URL (for QR codes — set to your ngrok URL when testing on phone) ──
VITE_PUBLIC_URL=
VITE_ALLOWED_HOSTS=

# ── TURN server (recommended for production) ──────────────────────────────────
# STUN alone (the default below) is enough for most home/office networks, but
# guests behind symmetric NAT or strict corporate/campus firewalls will fail
# to connect without a TURN relay. Comma-separate multiple STUN/TURN URLs.
# Leaving VITE_TURN_URLS empty just means those guests won't be able to
# connect — it won't break anything for everyone else, so it's safe to leave
# blank while testing locally, but set it before a real production launch.
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Dev tunnel shell env, used by `npm run tunnel` and never exposed to browser code.
NGROK_AUTHTOKEN=
