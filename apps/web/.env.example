# CollabStream — Web environment variables
# Copy this file to .env.local and fill in your values

# ── Supabase ─────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key   # Safe to expose — protected by RLS

# ── Stripe (public price IDs only — no secret keys here) ─────────────────────
VITE_STRIPE_PRO_PRICE_ID=price_...
VITE_STRIPE_BUSINESS_PRICE_ID=price_...

# ── Server / signaling ────────────────────────────────────────────────────────
VITE_SERVER_URL=http://localhost:3001
VITE_SIGNAL_URL=ws://localhost:3001/ws

# ── Public URL (for QR codes — set to your ngrok URL when testing on phone) ──
VITE_PUBLIC_URL=

# Dev tunnel shell env, used by `npm run tunnel` and never exposed to browser code.
NGROK_AUTHTOKEN=
